#!/bin/bash
set -euo pipefail

# ============================================================================
# 🚀 Odoo + ocli Environment Setup (Jinja2 template)
# ----------------------------------------------------------------------------
# Único valor dinámico: {{ odoo_version }}
# ============================================================================

# ----------------------------------------------------------------------------
# Rutas
# ----------------------------------------------------------------------------
readonly ODOO_VERSION="{{ odoo_version }}"
readonly REQUIREMENTS_URL="https://raw.githubusercontent.com/odoo/odoo/${ODOO_VERSION}/requirements.txt"
readonly REQUIREMENTS_FILE="requirements.txt"
readonly ODOO_DIR="odoo"
readonly ODOO_REPO="https://github.com/odoo/odoo.git"

if [[ -d "/workspace" ]]; then
    readonly WORKSPACE_DIR="/workspace"
else
    readonly WORKSPACE_DIR="$(pwd)"
fi

readonly VENV_DIR="${WORKSPACE_DIR}/.venv"          # siempre .venv
readonly OCLI_WORKSPACE="${WORKSPACE_DIR}/ocli"
readonly OCLI_INSTALL_DIR="${HOME}/.local/bin"
readonly OCLI_BIN="${OCLI_INSTALL_DIR}/ocli"

readonly OCLI_REPO="mjavint/ocli"
readonly OCLI_LATEST_URL="https://github.com/${OCLI_REPO}/releases/latest"
readonly OCLI_ASSET_BASE="https://github.com/${OCLI_REPO}/releases/latest/download"

readonly CURRENT_USER="$(whoami)"

# ----------------------------------------------------------------------------
# Logging con emojis por tipo de tarea
# ----------------------------------------------------------------------------
log_start()    { echo "🎬 $*"; }
log_info()     { echo "ℹ️  $*"; }
log_success()  { echo "✅ $*"; }
log_warn()     { echo "⚠️  $*"; }
log_error()    { echo "❌ $*" >&2; }
log_step()     { echo "▶️  $*"; }
log_check()    { echo "🔍 $*"; }
log_python()   { echo "🐍 $*"; }
log_install()  { echo "📦 $*"; }
log_download() { echo "📥 $*"; }
log_config()   { echo "🔧 $*"; }
log_update()   { echo "🔄 $*"; }
log_reuse()    { echo "♻️  $*"; }
log_cleanup()  { echo "🧹 $*"; }
log_net()      { echo "🌐 $*"; }
log_version()  { echo "📡 $*"; }
log_target()   { echo "🎯 $*"; }
log_clean()    { echo "✨ $*"; }
log_launch()   { echo "🚀 $*"; }
log_finish()   { echo "🎉 $*"; }

trap 'log_error "Fallo en la línea ${LINENO}"; exit 1' ERR

# ----------------------------------------------------------------------------
# Helpers de versión
# ----------------------------------------------------------------------------
normalize_version() {
    local v="${1#v}"
    echo "${v%%-*}"
}

get_bin_version() {
    local bin="$1"
    [[ -x "$bin" ]] || return 1
    local out
    out="$("$bin" --version 2>/dev/null || "$bin" version 2>/dev/null || true)"
    [[ -n "$out" ]] || return 1
    echo "$out" | grep -oE 'v?[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9.]+)?' | head -n1
}

get_latest_ocli_version() {
    local location
    location="$(curl -fsSI -o /dev/null -w '%{redirect_url}' \
        "$OCLI_LATEST_URL" 2>/dev/null || true)"
    [[ -n "$location" ]] || return 1
    echo "$location" | sed -nE 's#.*/tag/([^/]+)/?$#\1#p'
}

# ----------------------------------------------------------------------------
# Nombre del proyecto desde pyproject.toml (sanitizado)
# ----------------------------------------------------------------------------
get_project_name() {
    local name=""
    if [[ -f "pyproject.toml" ]]; then
        name="$(grep -E '^[[:space:]]*name[[:space:]]*=' pyproject.toml 2>/dev/null \
            | head -1 \
            | sed -E 's/^[^=]*=[[:space:]]*"([^"]+)".*/\1/')"
    fi
    [[ -z "$name" ]] && name="odoo-project"

    name="$(echo "$name" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9.-' '-' \
        | sed -E 's/^-+//; s/-+$//')"

    echo "$name"
}

# ----------------------------------------------------------------------------
# Ajuste del prompt en pyvenv.cfg
# ----------------------------------------------------------------------------
set_venv_prompt() {
    local venv_dir="$1" prompt_name="$2"
    local cfg="${venv_dir}/pyvenv.cfg"

    if [[ ! -f "$cfg" ]]; then
        log_warn "No existe ${cfg} → no se puede ajustar el prompt"
        return 1
    fi

    # Leer prompt actual (si existe)
    local current
    current="$(grep -E '^prompt[[:space:]]*=' "$cfg" 2>/dev/null \
        | head -1 \
        | sed -E 's/^prompt[[:space:]]*=[[:space:]]*//' \
        | sed -E 's/[[:space:]]+$//')"

    if [[ "$current" == "$prompt_name" ]]; then
        log_info "Prompt del venv ya configurado: (${prompt_name})"
        return 0
    fi

    # Borrar cualquier 'prompt = ...' existente
    sed -i.bak -E '/^prompt[[:space:]]*=/d' "$cfg" && rm -f "${cfg}.bak"

    # Añadir el nuevo
    printf 'prompt = %s\n' "$prompt_name" >> "$cfg"

    if [[ -n "$current" ]]; then
        log_clean "Prompt del venv actualizado: (${current}) → (${prompt_name})"
    else
        log_clean "Prompt del venv añadido: (${prompt_name})"
    fi
}

# ----------------------------------------------------------------------------
# Ajuste de requirements (compatibilidad Odoo 16/17/18)
# ----------------------------------------------------------------------------
update_requirements() {
    local version="$1"
    case "$version" in
        16.0|17.0|18.0)
            log_config "Ajustando gevent/greenlet/cbor2 para Odoo ${version}..."
            sed -i.bak -E \
                -e "s/(gevent==)21\.8\.0/\122.10.2/" \
                -e "s/(greenlet==)1\.1\.2/\12.0.2/" \
                -e "s/(cbor2==)5\.4\.2\.post1/\15.6.5/" \
                "$REQUIREMENTS_FILE" && rm -f "${REQUIREMENTS_FILE}.bak"
            log_success "Requirements ajustado para Odoo ${version}"
            ;;
        19.0|*)
            log_info "Usando requirements oficiales de Odoo ${version}"
            ;;
    esac
}

# ----------------------------------------------------------------------------
# Entorno virtual — .venv con prompt = nombre del proyecto
# ----------------------------------------------------------------------------
setup_venv() {
    log_step "Configurando entorno virtual..."

    local project_name
    project_name="$(get_project_name)"

    log_target "Nombre del proyecto : ${project_name}"
    log_target "Venv destino        : ${VENV_DIR}"
    log_target "Prompt mostrado     : (${project_name})"

    # ── Si ya existe → no reinstalar, solo asegurar el prompt ────────────
    if [[ -d "$VENV_DIR" ]]; then
        set_venv_prompt "$VENV_DIR" "$project_name"
        log_reuse "Venv existente en ${VENV_DIR} → no se reinstala"
        return 0
    fi

    # ── Crear ────────────────────────────────────────────────────────────
    if [[ -f "pyproject.toml" ]]; then
        log_python "Ejecutando 'uv sync' (crea ${VENV_DIR} desde pyproject.toml)..."
        UV_PROJECT_ENVIRONMENT="$VENV_DIR" uv sync --inexact \
            || { log_error "Falló uv sync"; return 1; }
    else
        log_warn "No hay pyproject.toml → usando 'uv venv' como fallback"
        uv venv "$VENV_DIR" --prompt "$project_name" \
            || { log_error "Falló uv venv"; return 1; }
    fi
    log_success "Venv creado en ${VENV_DIR}"

    # Refuerzo: garantizar el prompt en pyvenv.cfg (uv sync no siempre lo respeta)
    set_venv_prompt "$VENV_DIR" "$project_name"

    # ── Activar ──────────────────────────────────────────────────────────
    # shellcheck disable=SC1091
    source "${VENV_DIR}/bin/activate" \
        || { log_error "No se pudo activar el venv"; return 1; }
    log_clean "Venv activado: $(which python)"

    # ── Requirements de Odoo ─────────────────────────────────────────────
    log_download "Descargando requirements de Odoo ${ODOO_VERSION}..."
    log_net "URL: ${REQUIREMENTS_URL}"
    curl -fsSL -o "$REQUIREMENTS_FILE" "$REQUIREMENTS_URL" \
        || { log_error "No se pudo descargar requirements"; return 1; }
    log_success "requirements.txt descargado"

    update_requirements "$ODOO_VERSION"

    log_install "Instalando dependencias Python (requirements.txt)..."
    uv pip install --no-cache-dir -r "$REQUIREMENTS_FILE" \
        || { log_error "Falló la instalación de dependencias"; return 1; }
    log_success "Dependencias instaladas"

    log_cleanup "Eliminando requirements.txt temporal..."
    rm -f "$REQUIREMENTS_FILE"
    log_success "Limpieza completada"
}

# ----------------------------------------------------------------------------
# Clonado / actualización de Odoo
# ----------------------------------------------------------------------------
download_odoo() {
    log_check "Verificando repositorio de Odoo ${ODOO_VERSION}..."

    if [[ -d "$ODOO_DIR" ]]; then
        log_reuse "Directorio existente: ${ODOO_DIR}"

        if [[ ! -d "${ODOO_DIR}/.git" ]]; then
            log_error "${ODOO_DIR} existe pero no es un repositorio git"
            log_warn "Borra el directorio manualmente si quieres re-clonar"
            return 1
        fi

        local current_branch old_head new_head
        current_branch="$(git -C "$ODOO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo 'desconocida')"
        old_head="$(git -C "$ODOO_DIR" rev-parse --short HEAD 2>/dev/null || echo '?')"

        log_info "Branch actual   : ${current_branch}"
        log_info "Branch objetivo : ${ODOO_VERSION}"
        log_info "HEAD actual     : ${old_head}"

        if [[ -n "$(git -C "$ODOO_DIR" status --porcelain 2>/dev/null)" ]]; then
            log_warn "Hay cambios locales sin commitear en ${ODOO_DIR}"
            log_warn "Serán descartados al actualizar"
        fi

        log_update "Haciendo fetch de origin/${ODOO_VERSION} (shallow)..."
        if ! git -C "$ODOO_DIR" fetch --depth=1 origin \
                "${ODOO_VERSION}:refs/remotes/origin/${ODOO_VERSION}"; then
            log_warn "No se pudo hacer fetch (¿sin red?). Se conserva la copia local."
            return 0
        fi

        if [[ "$current_branch" != "$ODOO_VERSION" ]]; then
            log_update "Cambiando branch: ${current_branch} → ${ODOO_VERSION}"
            git -C "$ODOO_DIR" checkout -f -B "$ODOO_VERSION" \
                "origin/${ODOO_VERSION}" \
                || { log_error "No se pudo cambiar de branch"; return 1; }
        else
            log_update "Actualizando ${ODOO_VERSION} a origin/${ODOO_VERSION}..."
            git -C "$ODOO_DIR" reset --hard "origin/${ODOO_VERSION}" \
                || { log_error "No se pudo actualizar el repositorio"; return 1; }
        fi

        new_head="$(git -C "$ODOO_DIR" rev-parse --short HEAD 2>/dev/null || echo '?')"
        if [[ "$old_head" == "$new_head" ]]; then
            log_success "Odoo ya estaba actualizado (${new_head})"
        else
            log_success "Odoo actualizado: ${old_head} → ${new_head}"
        fi
        return 0
    fi

    log_download "No existe ${ODOO_DIR} → clonando por primera vez..."
    log_net "Repo: ${ODOO_REPO} (branch ${ODOO_VERSION})"
    git clone --depth 1 --branch "$ODOO_VERSION" "$ODOO_REPO" "$ODOO_DIR" \
        || { log_error "Falló git clone de Odoo"; return 1; }
    log_success "Odoo clonado en ${ODOO_DIR}"
}

# ----------------------------------------------------------------------------
# Detección de plataforma
# ----------------------------------------------------------------------------
detect_ocli_os() {
    local os
    os="$(uname -s | tr '[:upper:]' '[:lower:]')"
    case "$os" in
        linux)  echo "linux" ;;
        darwin) echo "darwin" ;;
        *)      log_error "OS no soportado por ocli: ${os}"; return 1 ;;
    esac
}

detect_ocli_arch() {
    local arch
    arch="$(uname -m)"
    case "$arch" in
        x86_64|amd64)  echo "amd64" ;;
        aarch64|arm64) echo "arm64" ;;
        *)             log_error "Arquitectura no soportada por ocli: ${arch}"; return 1 ;;
    esac
}

# ----------------------------------------------------------------------------
# FASE 1 — Descarga de ocli al workspace (idempotente)
# ----------------------------------------------------------------------------
download_ocli_to_workspace() {
    log_check "Verificando ocli en el workspace..."
    log_target "Ruta del workspace: ${OCLI_WORKSPACE}"

    local latest ws_ver
    log_version "Consultando última versión en GitHub..."
    latest="$(get_latest_ocli_version 2>/dev/null || true)"

    if [[ -f "$OCLI_WORKSPACE" ]]; then
        log_reuse "Encontrado: ${OCLI_WORKSPACE}"

        if [[ ! -x "$OCLI_WORKSPACE" ]]; then
            log_warn "El binario no era ejecutable, corrigiendo permisos..."
            chmod +x "$OCLI_WORKSPACE"
        fi

        ws_ver="$(get_bin_version "$OCLI_WORKSPACE" 2>/dev/null || true)"
        log_info "Versión en workspace : ${ws_ver:-desconocida}"
        log_info "Última versión GitHub: ${latest:-no disponible}"

        if [[ -n "$latest" && -n "$ws_ver" ]] && \
           [[ "$(normalize_version "$latest")" == "$(normalize_version "$ws_ver")" ]]; then
            log_success "Versiones coinciden → no se descarga nada"
            return 0
        fi

        if [[ -z "$latest" ]]; then
            log_warn "No se pudo verificar la última versión (sin red / rate-limit)."
            log_warn "Se mantiene la copia local: ${ws_ver:-desconocida}"
            return 0
        fi

        log_update "Versiones distintas → se descargará la nueva versión"
    else
        log_download "No existe ${OCLI_WORKSPACE} → se descargará ${latest:-la última versión}"
    fi

    local os arch url tmp
    os="$(detect_ocli_os)"     || return 1
    arch="$(detect_ocli_arch)" || return 1
    url="${OCLI_ASSET_BASE}/ocli-${os}-${arch}"
    tmp="${OCLI_WORKSPACE}.tmp.$$"

    log_info "Plataforma detectada: ${os}/${arch}"
    log_net "URL: ${url}"

    log_download "Descargando binario..."
    if ! curl -fsSL -o "$tmp" "$url"; then
        log_error "No se pudo descargar ocli desde ${url}"
        rm -f "$tmp"
        return 1
    fi

    local size
    size="$(stat -c%s "$tmp" 2>/dev/null || stat -f%z "$tmp" 2>/dev/null || echo 0)"
    if (( size < 1024 )); then
        log_error "Archivo descargado inválido (${size} bytes)"
        rm -f "$tmp"
        return 1
    fi

    chmod +x "$tmp"
    mv -f "$tmp" "$OCLI_WORKSPACE"
    log_success "ocli actualizado en ${OCLI_WORKSPACE}"
}

# ----------------------------------------------------------------------------
# FASE 2 — Instalación desde el workspace (idempotente)
# ----------------------------------------------------------------------------
install_ocli_from_workspace() {
    log_install "Instalando ocli desde el workspace..."

    if [[ ! -x "$OCLI_WORKSPACE" ]]; then
        log_error "No hay binario ejecutable en ${OCLI_WORKSPACE}"
        return 1
    fi

    local ws_ver local_ver
    ws_ver="$(get_bin_version "$OCLI_WORKSPACE" 2>/dev/null || true)"
    local_ver="$(get_bin_version "$OCLI_BIN"       2>/dev/null || true)"

    log_info "Versión en workspace: ${ws_ver:-desconocida}"
    log_info "Versión instalada  : ${local_ver:-no instalada}"

    if [[ -n "$ws_ver" && -n "$local_ver" ]] && \
       [[ "$(normalize_version "$ws_ver")" == "$(normalize_version "$local_ver")" ]]; then
        log_success "Versión ya instalada coincide con la del workspace → no se reinstala"
        return 0
    fi

    mkdir -p "$OCLI_INSTALL_DIR"
    install -m 755 "$OCLI_WORKSPACE" "$OCLI_BIN"
    log_success "ocli instalado en ${OCLI_BIN}"

    if command -v ocli &>/dev/null; then
        log_info "Versión en PATH: $(ocli --version 2>/dev/null || ocli version 2>/dev/null || echo '?')"
    else
        log_warn "~/.local/bin no está en PATH"
        log_warn "Añade esto a tu ~/.bashrc o ~/.zshrc:"
        echo '   export PATH="$HOME/.local/bin:$PATH"'
    fi
}

# ----------------------------------------------------------------------------
# Orquestador ocli
# ----------------------------------------------------------------------------
download_ocli() {
    download_ocli_to_workspace  || return 1
    install_ocli_from_workspace || return 1
}

# ----------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------
main() {
    log_start "Iniciando setup de Odoo ${ODOO_VERSION} + ocli..."

    log_launch "Paso 1/3 — Entorno virtual"
    setup_venv || exit 1

    log_launch "Paso 2/3 — Repositorio de Odoo"
    download_odoo || exit 1

    log_launch "Paso 3/3 — Herramienta ocli"
    download_ocli || exit 1

    log_finish "Entorno listo. Odoo ${ODOO_VERSION} y ocli disponibles."
}

main "$@"
